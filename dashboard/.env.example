# Browser-visible configuration ONLY. Everything VITE_-prefixed is compiled into the public bundle.
# The build refuses any other VITE_ variable and refuses a Supabase SECRET key (sb_secret_...).
#
# Supabase project URL (https://<project-ref>.supabase.co; http only for 127.0.0.1/localhost).
VITE_SUPABASE_URL=
# Supabase PUBLISHABLE key (sb_publishable_...). Safe for browsers; it is sent only to Supabase Auth,
# never to the dashboard backend.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Development only (read by vite.config.ts in Node, never exposed to the browser): where the dev and
# preview servers proxy /api. Default http://127.0.0.1:8000 (make dev).
# DASHBOARD_API_TARGET=http://127.0.0.1:8000
