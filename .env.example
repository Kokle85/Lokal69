# SUV deal system — environment template (placeholders only; spec section 26).
# Copy to .env and fill secrets through your approved secure method. NEVER commit .env.
# Names are this application's contract, not upstream product variables.
# Each process needs only the values listed for it in docs/runbook.md.

APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
DISPLAY_TIMEZONE=Europe/Skopje
LOG_LEVEL=INFO
BUILD_ID=dev

# --- Database (server-side only) -------------------------------------------
# Supabase: use the session-mode/direct connection for long-running workers.
# The app switches into the restricted role suv_backend on every connection (ADR 0001).
DATABASE_URL=
DATABASE_SET_ROLE=suv_backend
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5

# --- Supabase (Auth for the dashboard; keys: publishable = browser-safe, secret = server-only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=source-evidence-private
SNAPSHOT_STORAGE=disabled

# --- Crawler (host process may use 127.0.0.1; a Compose worker uses service DNS) ------
CRAWL4AI_BASE_URL=http://crawl4ai:11235
CRAWL4AI_API_TOKEN=
CRAWL4AI_IMAGE=unclecode/crawl4ai:0.9.4
CRAWL4AI_IMAGE_DIGEST=

# --- MCP server --------------------------------------------------------------
MCP_PUBLIC_URL=
MCP_AUTH_MODE=oauth
MCP_OAUTH_ISSUER=
MCP_OAUTH_AUDIENCE=
MCP_OAUTH_JWKS_URL=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_CURSOR_SIGNING_SECRET=
MCP_ALLOWED_ORIGINS=

# --- Scheduling and network switches (all external effects OFF by default) ----------
SCHEDULER_INTERVAL_SECONDS=900
SOURCE_NETWORK_ENABLED=false
ALLOW_EXTERNAL_NOTIFICATIONS=false
NOTIFICATION_PROVIDER=disabled
FX_FETCH_ENABLED=false

# --- Optional Slack fallback (disabled; see docs/notification_bridge.md) ----------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
SLACK_TEAM_ID=
SLACK_APP_ID=
SLACK_BOT_ID=
SLACK_BOT_USER_ID=
SLACK_DESTINATION_APPROVAL_REF=
CALLBACK_EGRESS_PROXY_URL=

# --- Native MCP Events (preferred activation route; disabled until gates pass) ----
EVENT_BRIDGE_ENABLED=false
EVENT_BRIDGE_PROVIDER=disabled
MCP_EVENTS_ENABLED=false
MCP_EVENT_SUBSCRIPTION_SECRET_ENCRYPTION_KEY=
EVENT_BRIDGE_VERIFIED_AT=

# --- Optional LLM extraction fallback (disabled; budget 0) ---------------------
LLM_EXTRACTION_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_DAILY_BUDGET_EUR=0

# --- Optional official mobile.de Search API (entitlement NOT verified) ---------
MOBILE_DE_API_ENABLED=false
MOBILE_DE_API_CREDENTIALS=
MOBILE_DE_API_ENTITLEMENT_REFERENCE=

# --- Business rules (confirmed values; validated at startup) -------------------
# Approved production tax rules are a separate activation gate.
TAX_RULE_SET_ID=
PRIMARY_MIN_PRICE_EUR=2500
PRIMARY_MAX_PRICE_EUR=3000
MAX_MILEAGE_KM_EXCLUSIVE=200000
MK_ASKING_BAND_MIN_EUR=8000
MK_ASKING_BAND_MAX_EUR=10000
MANUAL_4000_PROFILE_ENABLED=false
BELOW_TARGET_WATCH_ENABLED=false
PROPOSED_MIN_CONTRIBUTION_EUR=1500
CONTRIBUTION_THRESHOLD_APPROVED=false

# --- Spec v1.1 §37: bounded automatic seller inquiry (standing owner authorization) ----
# One inquiry per verified vehicle/seller pair: availability, documents, lowest/final price.
# No per-message or first-template approval. Stays off until the sender is technically verified.
SELLER_INQUIRY_MODE=disabled_until_sender_ready
SELLER_INQUIRY_KILL_SWITCH=false
SELLER_INQUIRY_AUTHORIZATION_SCOPE=availability_documents_lowest_price_once
SELLER_INQUIRY_REQUIRE_MESSAGE_APPROVAL=false
SELLER_INQUIRY_MAX_PER_24H=2
SELLER_INQUIRY_MAX_PER_ROLLING_15D=5
SELLER_EMAIL_PROVIDER=
SELLER_EMAIL_ACCOUNT_ID=
SELLER_EMAIL_FROM=
SELLER_EMAIL_REPLY_TO=
SELLER_EMAIL_OAUTH_SECRET_REFERENCE=
SELLER_REPLY_INGEST_MODE=local_classic_outlook
SELLER_REPLY_SIGNAL_PROVIDER=slack
MAIL_RECONCILE_INTERVAL_SECONDS=120
MAIL_WORKER_INGEST_API_URL=
MAIL_WORKER_CREDENTIAL_REFERENCE=
