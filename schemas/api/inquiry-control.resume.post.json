{
  "auth": "user_jwt",
  "errors": [
    "UNAUTHENTICATED",
    "FORBIDDEN",
    "VALIDATION_ERROR",
    "RATE_LIMITED",
    "DEPENDENCY_UNAVAILABLE",
    "INTERNAL_ERROR",
    "IDEMPOTENCY_CONFLICT",
    "VERSION_CONFLICT"
  ],
  "idempotencyKeyHeader": "optional",
  "mcpTool": null,
  "method": "POST",
  "paginated": false,
  "path": "/api/inquiry-control/resume",
  "request": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Body of ``POST /api/inquiry-control/resume`` (owner only; never an MCP tool).\n\n``remove_suppressions``: also remove (audited, one audit event per suppression) the active\n``kill_switch`` suppressions and, while the current standing authorization is effective and\nunrevoked, the ``authorization_revoked`` ones. Other suppressions (opt-out, bounce, complaint,\nsender revoked, ...) are never removed here.",
    "properties": {
      "expected_version": {
        "minimum": 1,
        "type": "integer"
      },
      "idempotency_key": {
        "description": "Client-chosen key scoped to the caller and operation; a retry with the same key and request returns the original result.",
        "maxLength": 128,
        "minLength": 8,
        "pattern": "^[A-Za-z0-9._:-]{8,128}$",
        "type": "string"
      },
      "reason": {
        "description": "Why (recorded in the audit trail).",
        "maxLength": 2000,
        "minLength": 3,
        "type": "string"
      },
      "remove_suppressions": {
        "default": false,
        "type": "boolean"
      }
    },
    "required": [
      "expected_version",
      "reason",
      "idempotency_key"
    ],
    "title": "InquiryResumeRequest",
    "type": "object"
  },
  "requestLocation": "body",
  "requiredScope": "config:admin",
  "response": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "as_of": {
        "format": "date-time",
        "type": "string"
      },
      "data": {
        "additionalProperties": false,
        "description": "``POST /api/inquiry-control/resume`` (owner, dashboard only) result.",
        "properties": {
          "kill_switch": {
            "const": false,
            "default": false,
            "type": "boolean"
          },
          "mode": {
            "enum": [
              "disabled_until_sender_ready",
              "automatic",
              "paused"
            ],
            "type": "string"
          },
          "resumed_at": {
            "format": "date-time",
            "type": "string"
          },
          "suppressions_removed": {
            "default": 0,
            "description": "Suppressions removed with this resume (each one audited).",
            "minimum": 0,
            "type": "integer"
          },
          "version": {
            "description": "The new control version.",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "version",
          "kill_switch",
          "mode",
          "resumed_at",
          "suppressions_removed"
        ],
        "title": "InquiryResumeResult",
        "type": "object"
      },
      "next_cursor": {
        "default": null,
        "maxLength": 2048,
        "minLength": 1,
        "type": [
          "string",
          "null"
        ]
      },
      "request_id": {
        "pattern": "^[\\x21-\\x7e]{1,200}$",
        "type": "string"
      },
      "schema_version": {
        "const": "1.0",
        "default": "1.0",
        "type": "string"
      },
      "warnings": {
        "default": [],
        "items": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "description": "Typed warning codes. Each warning also carries a user-readable explanation.",
              "enum": [
                "STALE_DATA",
                "SOURCE_PAUSED",
                "SOURCE_BLOCKED",
                "COVERAGE_GAP",
                "FIXTURE_DATA",
                "RESEARCH_CANDIDATE",
                "VALUATION_INCOMPLETE",
                "VALUATION_STALE",
                "UNKNOWN_COSTS",
                "INSUFFICIENT_COMPARABLES",
                "SMALL_COMPARABLE_SAMPLE",
                "ASKING_NOT_SALE",
                "THRESHOLD_PROPOSED",
                "TAX_RULES_UNAPPROVED",
                "FX_STALE",
                "SELLER_CLAIMS_UNVERIFIED",
                "SCORE_NOT_PROBABILITY",
                "FROZEN_QUEUE_PROJECTION",
                "REVISION_NOT_CURRENT",
                "NEW_REVISION_AVAILABLE",
                "CLAIM_EXPIRING",
                "ACTIVATION_BLOCKED",
                "PARTIAL_RESULTS",
                "DEPENDENCY_DEGRADED"
              ],
              "type": "string"
            },
            "message": {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "title": "Warning",
          "type": "object"
        },
        "maxItems": 50,
        "type": "array"
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "as_of",
      "data",
      "warnings",
      "next_cursor"
    ],
    "title": "inquiry-control.resume.post_response",
    "type": "object"
  },
  "successStatus": 200,
  "summary": "Owner-only: clear the kill switch against the expected control version; optionally remove kill-switch/authorization-revoked suppressions (each audited)."
}
