        "minLength": 8,
        "pattern": "^[A-Za-z0-9._:-]{8,128}$",
        "type": "string"
      },
      "profile_key": {
        "pattern": "^[a-z0-9_]{1,80}$",
        "type": "string"
      },
      "version": {
        "minimum": 1,
        "type": "integer"
      }
    },
    "required": [
