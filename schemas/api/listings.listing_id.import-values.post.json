  "request": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Body of ``POST /api/listings/{listing_id}/import-values`` (owner only): record the listing's\nreal purchase price and/or estimated customs value (at least one). Each supersedes the current\nrecorded value of its kind; the listing's valuations are recomputed with them.",
    "properties": {
      "estimated_customs_value": {
        "additionalProperties": false,
        "default": null,
        "description": "The ESTIMATED customs value (проценета царинска вредност) of the vehicle to record: in EUR,\nWITHOUT transport, e.g. the SchwackeNet catalogue value. The import charges are computed on it.",
        "properties": {
          "amount_eur": {
            "description": "Amount in EUR, more than zero, without transport, e.g. \"4200\".",
            "maxLength": 16,
            "minLength": 1,
            "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,2})?$",
            "type": "string"
          },
          "document_ref": {
            "default": null,
            "description": "Reference of the document.",
            "maxLength": 200,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "description": "Where the estimate comes from, e.g. \"SchwackeNet catalogue\".",
            "maxLength": 120,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "amount_eur",
          "source"
        ],
        "title": "RecordCustomsValueInput",
        "type": [
          "object",
          "null"
        ]
      },
      "idempotency_key": {
        "description": "Client-chosen key scoped to the caller and operation; a retry with the same key and request returns the original result.",
        "maxLength": 128,
        "minLength": 8,
        "pattern": "^[A-Za-z0-9._:-]{8,128}$",
        "type": "string"
      },
      "purchase_price": {
        "additionalProperties": false,
        "default": null,
        "description": "The REAL purchase price (реална набавна цена) to record: what is, or will be, actually paid,\nin EUR. The profit and the landed cost use it; it never replaces the customs value.",
        "properties": {
          "amount": {
            "description": "Amount in EUR, more than zero, e.g. \"2800.00\".",
            "maxLength": 16,
            "minLength": 1,
            "pattern": "^(0|[1-9][0-9]{0,12})(\\.[0-9]{1,2})?$",
            "type": "string"
          },
          "currency": {
            "const": "EUR",
            "description": "EUR only (convert at the rate actually paid).",
            "type": "string"
          },
          "document_ref": {
            "default": null,
            "description": "Reference of the document.",
            "maxLength": 200,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "description": "actual: paid (invoice/contract); quote: offered or agreed, not yet paid; estimate.",
            "enum": [
              "actual",
              "quote",
              "estimate"
            ],
            "type": "string"
          },
          "source": {
            "description": "Where the price comes from, e.g. \"seller invoice\".",
            "maxLength": 120,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency",
          "kind",
          "source"
        ],
        "title": "RecordPurchasePriceInput",
        "type": [
          "object",
          "null"
        ]
      }
    },
    "required": [
      "idempotency_key"
    ],
