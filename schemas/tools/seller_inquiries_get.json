      "code": {
        "enum": [
          "VALIDATION_ERROR",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "NOT_FOUND",
          "VERSION_CONFLICT",
          "ALREADY_CLAIMED",
          "CLAIM_EXPIRED",
          "IDEMPOTENCY_CONFLICT",
          "SOURCE_PAUSED",
          "ACCESS_BLOCKED",
          "RATE_LIMITED",
          "INSUFFICIENT_DATA",
          "DEPENDENCY_UNAVAILABLE",
          "INTERNAL_ERROR",
          "EMAIL_DELIVERY_UNCERTAIN"
