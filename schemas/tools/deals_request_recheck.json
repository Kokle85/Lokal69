{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": false,
    "title": "Request a listing recheck"
  },
  "description": "Queue a bounded, budget-controlled recheck of a registered listing and return the job id. Never fetches an arbitrary URL; paused or blocked sources are not contacted.",
  "errorSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Typed tool error (``isError: true`` result content). Same codes as the dashboard API.",
    "properties": {
      "code": {
        "enum": [
          "VALIDATION_ERROR",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "NOT_FOUND",
          "VERSION_CONFLICT",
          "ALREADY_CLAIMED",
          "CLAIM_EXPIRED",
          "IDEMPOTENCY_CONFLICT",
          "SOURCE_PAUSED",
          "ACCESS_BLOCKED",
          "RATE_LIMITED",
          "INSUFFICIENT_DATA",
          "DEPENDENCY_UNAVAILABLE",
          "INTERNAL_ERROR",
          "EMAIL_DELIVERY_UNCERTAIN"
        ],
        "type": "string"
      },
      "correlation_id": {
        "default": null,
        "pattern": "^[\\x21-\\x7e]{1,200}$",
        "type": [
          "string",
          "null"
        ]
      },
      "details": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "default": null,
        "type": [
          "object",
          "null"
        ]
      },
      "message": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "retry_after_seconds": {
        "default": null,
        "maximum": 86400,
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "retryable": {
        "type": "boolean"
      }
    },
    "required": [
      "code",
      "message",
      "retryable",
      "retry_after_seconds",
      "correlation_id",
      "details"
    ],
    "title": "ToolError",
    "type": "object"
  },
  "idempotencyOperation": "deals_request_recheck",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "idempotency_key": {
        "description": "Client-chosen key scoped to the caller and operation; a retry with the same key and request returns the original result.",
        "maxLength": 128,
        "minLength": 8,
        "pattern": "^[A-Za-z0-9._:-]{8,128}$",
        "type": "string"
      },
      "listing_id": {
        "format": "uuid",
        "type": "string"
      },
      "reason": {
        "description": "Why (recorded in the audit trail).",
        "maxLength": 2000,
        "minLength": 3,
        "type": "string"
      }
    },
    "required": [
      "listing_id",
      "reason",
      "idempotency_key"
    ],
    "title": "deals_request_recheck",
    "type": "object"
  },
  "name": "deals_request_recheck",
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "as_of": {
        "format": "date-time",
        "type": "string"
      },
      "data": {
        "additionalProperties": false,
        "description": "Result of ``deals_request_recheck``: the queued (or deduplicated) job.",
        "properties": {
          "available_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "deduplicated": {
            "type": "boolean"
          },
          "job_id": {
            "format": "uuid",
            "type": "string"
          },
          "job_type": {
            "const": "recheck",
            "default": "recheck",
            "type": "string"
          },
          "listing_id": {
            "format": "uuid",
            "type": "string"
          },
          "notice": {
            "default": "Queued, budget-controlled recheck of the registered listing; no arbitrary URL is fetched.",
            "type": "string"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "retry_wait",
              "blocked",
              "dead_letter",
              "cancelled"
            ],
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "listing_id",
          "job_type",
          "state",
          "deduplicated",
          "available_at",
          "notice"
        ],
        "title": "RecheckRequestResult",
        "type": "object"
      },
      "next_cursor": {
        "default": null,
        "maxLength": 2048,
        "minLength": 1,
        "type": [
          "string",
          "null"
        ]
      },
      "request_id": {
        "pattern": "^[\\x21-\\x7e]{1,200}$",
        "type": "string"
      },
      "schema_version": {
        "const": "1.0",
        "default": "1.0",
        "type": "string"
      },
      "warnings": {
        "default": [],
        "items": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "description": "Typed warning codes. Each warning also carries a user-readable explanation.",
              "enum": [
                "STALE_DATA",
                "SOURCE_PAUSED",
                "SOURCE_BLOCKED",
                "COVERAGE_GAP",
                "FIXTURE_DATA",
                "RESEARCH_CANDIDATE",
                "VALUATION_INCOMPLETE",
                "VALUATION_STALE",
                "UNKNOWN_COSTS",
                "INSUFFICIENT_COMPARABLES",
                "SMALL_COMPARABLE_SAMPLE",
                "ASKING_NOT_SALE",
                "THRESHOLD_PROPOSED",
                "TAX_RULES_UNAPPROVED",
                "FX_STALE",
                "SELLER_CLAIMS_UNVERIFIED",
                "SCORE_NOT_PROBABILITY",
                "FROZEN_QUEUE_PROJECTION",
                "REVISION_NOT_CURRENT",
                "NEW_REVISION_AVAILABLE",
                "CLAIM_EXPIRING",
                "ACTIVATION_BLOCKED",
                "PARTIAL_RESULTS",
                "DEPENDENCY_DEGRADED"
              ],
              "type": "string"
            },
            "message": {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "title": "Warning",
          "type": "object"
        },
        "maxItems": 50,
        "type": "array"
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "as_of",
      "data",
      "warnings",
      "next_cursor"
    ],
    "title": "deals_request_recheck_result",
    "type": "object"
  },
  "paginated": false,
  "requiredScope": "rechecks:request",
  "title": "Request a listing recheck"
}
