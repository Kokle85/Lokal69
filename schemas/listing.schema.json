          "field": {
            "maxLength": 120,
            "type": "string"
          },
          "locations": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "type": "array"
          },
          "note": {
            "default": null,
            "maxLength": 500,
            "type": [
              "string",
              "null"
