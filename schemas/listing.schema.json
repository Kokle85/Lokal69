      "description": "Each field names a positive proposition; the ClaimStatus says how it is supported.",
      "properties": {
        "accident_free": {
          "default": "unknown",
          "description": "Status of a seller/vehicle statement. Extraction confidence is separate.",
          "enum": [
            "verified",
            "seller_claimed",
            "seller_denied",
            "conflicting",
            "unknown"
          ],
          "type": "string"
