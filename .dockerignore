# Keep the build context small and free of secrets (Dockerfile copies only what it needs).
.git
.gitignore
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
**/secrets/
var/
.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/
dist/
build/
*.egg-info/
tests/
docs/
desktop/
dashboard/node_modules/
dashboard/dist/
dashboard/test-results/
dashboard/playwright-report/
schemas/
supabase/tests/
supabase/seed.sql
compose*.yaml
Dockerfile
.dockerignore
